# ============================================================================
# TRE PREDATOR v1.0 — Environment Configuration Template (`.env.example`)
# Copy to `.env` and fill in your OKX Demo (Simulated Trading) API Credentials
# ============================================================================

# 1. OKX DEMO TRADING CREDENTIALS (sends `x-simulated-trading: 1` header)
OKX_API_KEY="YOUR_OKX_DEMO_API_KEY"
OKX_SECRET_KEY="YOUR_OKX_DEMO_SECRET_KEY"
OKX_PASSPHRASE="YOUR_OKX_DEMO_PASSPHRASE"
OKX_SIMULATED_DEMO="1"

# 2. MULTI-AGENT LLM COUNCIL CREDENTIALS (OpenRouter Free + Local Ollama GPU)
OPENROUTER_API_KEY="YOUR_OPENROUTER_API_KEY"
OPENROUTER_MODEL="openrouter/free"
OLLAMA_URL="http://100.125.189.103:11434/api/generate"
OLLAMA_MODEL="nemotron-3.5-lightning:latest"

# 3. OPTIONAL TELEGRAM ALERTS
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
